{
  "name": "tcmb-doviz-kuru-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/tcmb-doviz-kuru",
    "packages/tcmb-doviz-kuru-mcp"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build -w tcmb-doviz-kuru && tsc",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build -w tcmb-doviz-kuru && npm test --workspaces",
    "coverage": "npm run build -w tcmb-doviz-kuru && npm run coverage --workspaces --if-present"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
